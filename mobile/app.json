{
  "expo": {
    "name": "Cairn",
    "slug": "cairn-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cairn",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gerardslee.cairn"
    },
    "android": {
      "package": "com.gerardslee.cairn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#8FA87E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withAppleSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
