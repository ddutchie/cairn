{
  "expo": {
    "name": "Cairn",
    "slug": "cairn-mobile",
    "version": "0.1.15",
    "orientation": "portrait",
    "scheme": "cairn",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/CairnMacIcon.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.gerardslee.cairn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gerardslee.cairn",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#8FA87E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cairn uses your photos to add images to notes and chat messages.",
          "cameraPermission": "Cairn uses the camera to add photos to notes and chat messages.",
          "microphonePermission": "Cairn uses the microphone to dictate messages and notes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cairn uses the camera to add photos to notes and chat messages.",
          "microphonePermission": "Cairn uses the microphone to dictate messages and notes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cairn uses the microphone to dictate messages and notes.",
          "speechRecognitionPermission": "Cairn uses speech recognition to turn your voice into text for messages and notes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cairn uses your photos to add images to notes and chat messages.",
          "savePhotosPermission": "Cairn saves photos you capture in chat.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "./plugins/withAppleSigning",
      "./plugins/withICloudContainer",
      "./plugins/withPrivateCloudCompute",
      "./plugins/withPodDeploymentTarget",
      "./plugins/withStatusBarStyle",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f4f1",
          "dark": {
            "image": "./assets/splashIcon.png",
            "backgroundColor": "#0d0d0d"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b9634bc3-1e30-4cc2-82a4-4d43a2ed5644"
      },
      "router": {}
    },
    "owner": "gerardslee",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b9634bc3-1e30-4cc2-82a4-4d43a2ed5644"
    }
  }
}
