{
  "expo": {
    "name": "Cairn",
    "slug": "cairn-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cairn",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gerardslee.cairn"
    },
    "android": {
      "package": "com.gerardslee.cairn",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#8FA87E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cairn uses your photos to attach images to chat messages.",
          "cameraPermission": "Cairn uses the camera to attach photos to chat messages."
        }
      ],
      "./plugins/withAppleSigning",
      "./plugins/withICloudContainer",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f4f1",
          "dark": {
            "image": "./assets/splashIcon.png",
            "backgroundColor": "#0d0d0d"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
