{
  "expo": {
    "name": "Cairn",
    "slug": "cairn-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cairn",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gerardslee.cairn"
    },
    "android": {
      "package": "com.gerardslee.cairn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#8FA87E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cairn uses your photos to attach images to chat messages.",
          "cameraPermission": "Cairn uses the camera to attach photos to chat messages."
        }
      ],
      "./plugins/withAppleSigning",
      "./plugins/withICloudContainer",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
