{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["shared/**/*.ts"],
  "exclude": [
    "node_modules",
    "shared/sync/transport.ts",
    "shared/sync/transport.test.ts"
  ]
}
