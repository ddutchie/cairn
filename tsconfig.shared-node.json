{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "shared/sync/transport.ts",
    "shared/sync/transport.test.ts",
    "electron/db/schema.ts",
    "electron/db/queries.ts",
    "electron/db/**/*.ts",
    "electron/sync/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
