{
  "name": "cairn",
  "version": "3.1.7",
  "description": "Local-first project management with AI and MCP",
  "author": "Cairn",
  "private": true,
  "scripts": {
    "test": "node scripts/generate-licenses.js && node scripts/generate-features.js && npm run compile && vitest run",
    "test:fast": "vitest run",
    "test:live": "CAIRN_LIVE_TESTS=1 CAIRN_LIVE=1 vitest run",
    "test:unit": "vitest run --project node",
    "bench:graph": "vitest bench --project node --run electron/db/bench/graph.bench.ts",
    "test:component": "vitest run --project component",
    "test:watch": "vitest",
    "test:coverage": "npm run compile && vitest run --coverage",
    "dev": "node scripts/generate-licenses.js && node scripts/generate-features.js && concurrently -n next,esbuild,electron -c cyan,magenta,yellow \"next dev\" \"npm run compile:watch\" \"wait-on http://localhost:3000 dist-electron/main.js && node scripts/electron-dev.js\"",
    "build:mac": "node scripts/build.js --mac",
    "build:win": "node scripts/build.js --win",
    "build:linux": "node scripts/build.js --linux",
    "build:all": "node scripts/build.js --mac --win --linux",
    "compile": "node scripts/compile-electron.js",
    "compile:watch": "node scripts/compile-electron.js --watch",
    "build:embeddings-binary": "node scripts/build-embeddings-binary.js",
    "generate-tray-icon": "node scripts/generate-tray-icon.js",
    "postinstall": "patch-package && node -e \"if(!process.env.CI){require('child_process').execSync('electron-builder install-app-deps',{stdio:'inherit'})}else{console.log('Skipping install-app-deps in CI (handled by npm run rebuild)')}\"",
    "rebuild": "node scripts/rebuild-native.js",
    "build:mcp-binary": "node scripts/build-mcp-binary.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "type-check:electron": "tsc --noEmit -p tsconfig.electron.json",
    "type-check:shared": "tsc --noEmit -p tsconfig.shared.json && tsc --noEmit -p tsconfig.shared-node.json",
    "type-check:all": "npm run type-check && npm run type-check:electron && npm run type-check:shared",
    "mcp": "node dist-mcp/mcp-server.bundle.js",
    "smoke-test": "node scripts/smoke-test.js",
    "smoke-test:mcp": "node scripts/smoke-test-mcp.js",
    "test:e2e": "playwright test",
    "test:bundle": "npm run compile && vitest run electron/bundle-guard.test.ts electron/native-deps-guard.test.ts electron/mcp-server.test.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:electron": "npm run compile && playwright test -c playwright.electron.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "screenshots:update": "playwright test -c playwright.screenshots.config.ts",
    "screenshots:electron": "npm run compile && node --experimental-strip-types scripts/capture-screenshots.ts",
    "screenshots:all": "npm run screenshots && npm run screenshots:electron",
    "screenshots:audit": "playwright test -c playwright.audit.config.ts",
    "screenshots:compare": "node scripts/design-audit-compare.js"
  },
  "main": "dist-electron/main.js",
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "file:electron/sharp-stub",
    "onnxruntime-node": "1.23.0"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.0",
    "@dagrejs/dagre": "^3.0.0",
    "@earendil-works/pi-ai": "0.87.1",
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "3d-force-graph": "^1.80.1",
    "better-sqlite3": "^13.0.3",
    "d3": "^7.9.0",
    "d3-hierarchy": "^3.1.2",
    "d3-sankey": "^0.12.3",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "katex": "^0.18.4",
    "loadersz": "^0.9.0",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.23.0",
    "parse-diff": "^0.12.0",
    "partial-json": "^0.1.7",
    "pdfjs-dist": "^6.2.108",
    "react-day-picker": "^10.0.1",
    "react-virtuoso": "^4.18.11",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-math": "^6.0.0",
    "three": "^0.186.1",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/core": "^1.2.1",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-sankey": "^0.12.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "@yao-pkg/pkg": "^6.19.0",
    "ai": "^7.0.4",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "16.2.9",
    "gpt-tokenizer": "^3.4.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.11.0",
    "nanoid": "^5.1.9",
    "next": "16.2.9",
    "patch-package": "8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  }
}
