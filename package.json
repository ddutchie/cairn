{
  "name": "cairn",
  "version": "0.7.3",
  "description": "Local-first project management with AI and MCP",
  "author": "Cairn",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "node scripts/generate-licenses.js && concurrently -n next,esbuild,electron -c cyan,magenta,yellow \"next dev\" \"npm run compile:watch\" \"wait-on http://localhost:3000 dist-electron/main.js && node scripts/electron-dev.js\"",
    "compile:watch": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --external:electron --external:better-sqlite3 --outdir=dist-electron --format=cjs --watch",
    "build:mac": "node scripts/build.js --mac",
    "build:win": "node scripts/build.js --win",
    "build:linux": "node scripts/build.js --linux",
    "build:all": "node scripts/build.js --mac --win --linux",
    "compile": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node20 --external:electron --external:better-sqlite3 --outdir=dist-electron --format=cjs && esbuild electron/mcp-server.ts --bundle --platform=node --target=node20 --external:better-sqlite3 --outfile=dist-mcp/mcp-server.bundle.js --format=cjs",
    "generate-tray-icon": "node scripts/generate-tray-icon.js",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "node scripts/rebuild-native.js",
    "build:mcp-binary": "node scripts/build-mcp-binary.js",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "mcp": "node dist-mcp/mcp-server.bundle.js"
  },
  "main": "dist-electron/main.js",
  "overrides": {
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^12.9.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "mermaid": "^11.14.0",
    "react-day-picker": "^9.14.0",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/history": "^0.19.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "@yao-pkg/pkg": "^6.19.0",
    "ai": "^6.0.168",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "gray-matter": "^4.0.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.11.0",
    "nanoid": "^5.1.9",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  }
}
