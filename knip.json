{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "electron/runtime/server.ts",
    "electron/embeddings/server.ts",
    "electron/mcp-server.ts",
    "next.config.*",
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "scripts/*.js",
    "scripts/*.ts",
    "pkg.config.js",
    "vitest-sqlite-shim.cjs"
  ],
  "ignore": [
    "mobile/**",
    "electron/sharp-stub/**",
    "tests/**",
    "tests/e2e/**",
    "**/*.test.ts"
  ],
  "ignoreDependencies": [
    "d3-zoom",
    "cmdk",
    "d3-selection",
    "@types/d3-selection",
    "@types/d3-zoom",
    "@yao-pkg/pkg"
  ],
  "ignoreBinaries": [
    "electron-rebuild"
  ]
}
